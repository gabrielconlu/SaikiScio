PGHOST=localhost
PGPORT=5432
PGDATABASE=saikiscio
PGUSER=saikiscio_app
PGPASSWORD=example
API_PORT=3001
# On Vercel, set DATABASE_URL to your hosted PostgreSQL connection string instead.
# DATABASE_URL=
# SITE_ORIGINS is optional in production for a same-origin Vercel deployment.
SITE_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
GEMINI_API_KEY=replace_with_your_google_ai_studio_api_key
GEMINI_MODEL=gemini-3.5-flash
